{
  "schema_version": "e001-phase-2d-a-preregistration-v1",
  "created_before_development_scoring": true,
  "active_condition": "geographic",
  "allowed_partitions": ["train", "development"],
  "forbidden_partition": "final_test",
  "selection": {
    "primary_metric": "balanced_accuracy",
    "selection_partition": "geographic_development",
    "effective_tie_absolute_difference_less_than": 0.02,
    "tie_breaks": [
      "prefer_logistic_regression",
      "prefer_fewer_representation_channels",
      "prefer_model_order_dummy_then_logistic_regression_then_random_forest",
      "prefer_representation_order_normalized_elevation_then_slope_then_hillshade_then_local_relief_then_all_four"
    ],
    "secondary_metric_only": "roc_auc",
    "classification_threshold": 0.5
  },
  "pooling": {
    "method": "non_overlapping_mean",
    "block_shape": [4, 4],
    "input_shape": [128, 128],
    "output_shape": [32, 32],
    "features_per_representation": 1024
  },
  "representations": {
    "normalized_elevation": ["elevation_normalized"],
    "slope": ["slope_degrees"],
    "hillshade": ["hillshade_315_45"],
    "local_relief": ["local_relief_r16m"],
    "all_four": [
      "elevation_normalized",
      "slope_degrees",
      "hillshade_315_45",
      "local_relief_r16m"
    ]
  },
  "models": {
    "dummy": {
      "class": "sklearn.dummy.DummyClassifier",
      "parameters": {"strategy": "prior"},
      "standard_scaler": false
    },
    "logistic_regression": {
      "class": "sklearn.linear_model.LogisticRegression",
      "parameters": {
        "C": 1.0,
        "penalty": "l2",
        "solver": "lbfgs",
        "max_iter": 2000,
        "random_state": 20260829
      },
      "standard_scaler": true
    },
    "random_forest": {
      "class": "sklearn.ensemble.RandomForestClassifier",
      "parameters": {
        "n_estimators": 300,
        "max_depth": 8,
        "min_samples_leaf": 5,
        "max_features": "sqrt",
        "n_jobs": 1,
        "random_state": 20260829
      },
      "standard_scaler": false
    }
  },
  "training_label_permutation_sanity_check": {
    "seeds": [20260830, 20260831, 20260832, 20260833, 20260834],
    "applies_after_selection_to": "selected_model_and_representation",
    "changes_development_labels": false,
    "used_for_selection": false
  },
  "random_development_evaluation": {
    "run_in_phase_2d_a": false,
    "reason": "The geographic condition is the primary selection condition; the random condition remains untouched in this bounded run."
  },
  "prohibited_features": [
    "coordinates",
    "provenance_id",
    "survey_year",
    "geographic_block_id",
    "source_resolution_m",
    "sample_id",
    "filename_or_directory_label_encoding"
  ]
}
